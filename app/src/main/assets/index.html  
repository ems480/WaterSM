/* ── report ── */
function scores(){
  const g=G, days=Math.max(1,g.days);
  const avgSupply=g.supplyTotal>0?(g.supplyTotalAvg||16):16;
  const supplyScore=clamp((g.avgSupply??16)/16,0,1)*30;
  const nrw=g.produced>0?clamp((g.produced-g.billedVol)/g.produced,0,1):0;
  const nrwScore=clamp((0.5-nrw)/0.25,0,1)*25;
  const coll=g.lastCollection??DIFF[g.diff].collect;
  const collScore=clamp(coll/0.85,0,1)*20;
  const qualScore=clamp(1-g.clLowH/Math.max(1,g.supplyTotal)*3,0,1)*15;
  const warmaScore=clamp(1-g.warmaWarn*.4,0,1)*10;
  return {supplyScore,nrwScore,collScore,qualScore,warmaScore,nrw,coll,
    total:Math.round(supplyScore+nrwScore+collScore+qualScore+warmaScore)};
}
