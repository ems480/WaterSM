cv.addEventListener('pointerdown',e=>{
  if(!G||paused) return;
  const r=cv.getBoundingClientRect();
  const x=(e.clientX-r.left-offX)/scale, y=(e.clientY-r.top-offY)/scale;
  for(let i=0;i<G.leaks.length;i++){ const l=G.leaks[i];
    if(Math.hypot(x-l.x,y-l.y)<58){ fixLeak(i); return; } }
  for(const h of G.houses){ if(Math.abs(x-h.x)<54&&Math.abs(y-h.y)<48){
    toast('info',`Connection #${h.id} · ${h.type} · used ${h.used.toFixed(1)} m³ · satisfaction ${Math.round(h.sat*100)}%`); return; } }
});

