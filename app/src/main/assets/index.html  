function shake(m){ shakeT=Math.max(shakeT,m); $('#stage').classList.add('shake'); setTimeout(()=>$('#stage').classList.remove('shake'),430); }
function updateParticles(dt){
  for(let i=particles.length-1;i>=0;i--){ const p=particles[i];
    p.life-=dt; if(p.life<=0){ particles.splice(i,1); continue; }
    p.x+=p.vx*dt; p.y+=p.vy*dt; p.vy+=340*dt; p.vx*=.99; }
  if(particles.length>420) particles.splice(0,particles.length-420);
}

