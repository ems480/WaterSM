<script>
"use strict";
/* ═══════════════════════════════════════════════════════════════
   WaterSims — Scheme One. Single-file water-utility tycoon/trainer.
   ═══════════════════════════════════════════════════════════════ */
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const clamp=(v,a,b)=>v<a?a:v>b?b:v, lerp=(a,b,t)=>a+(b-a)*t, rnd=(a,b)=>a+Math.random()*(b-a);
const K=n=>'K'+Math.round(n).toLocaleString('en-US');
const BRIDGE=(typeof window.AndroidBridge!=='undefined')?window.AndroidBridge:null;

/* ── difficulty ── */
const DIFF=[
  {name:'TRAINEE',funds:18000,leakRate:.55,demand:.85,collect:.82,shed:.7},
  {name:'OPERATOR',funds:12000,leakRate:1,demand:1,collect:.74,shed:1},
  {name:'MANAGER',funds:8000,leakRate:1.5,demand:1.15,collect:.66,shed:1.35}
];
const TARIFF=6.5, POWER_KWH=2.2, OPEX_DAY=110, DOSE_COST=80, READ_COST=150, REPAIR_COST=340;
const WARMA_CAP=115;            // m³/day abstraction licence
const START_DAY=15, INSPECT_DAY=30, READ_A=25, READ_B=28;
const VW=1000, VH=700;          // virtual map space

const HOUSE_POS=[
  {x:140,y:400},{x:320,y:400},{x:500,y:400},{x:680,y:400},{x:860,y:400},
  {x:140,y:590},{x:320,y:590},{x:500,y:590},{x:680,y:590},{x:860,y:590}
];
const DIURNAL=[.35,.3,.3,.3,.4,.8,1.6,1.9,1.7,1.2,1,1,1.1,1,.9,1,1.3,1.7,1.8,1.5,1.1,.8,.6,.45];
const SHED_BLOCKS=[[8,12],[16,20],[6,10],[14,18],[10,14],[18,22]];

/* ── state ── */
let G=null, running=false, paused=false, speed=1, soundOn=true, tReal=0, lastNow=0;
let particles=[], shakeT=0, hoverLeak=-1;

function newGame(diff,withTut){
  const D=DIFF[diff];
  G={
    diff, day:START_DAY, hour:6, min:0, funds:D.funds, xp:0, level:1,
    tank:{cap:50,vol:21}, pump:{on:false}, power:{on:true,block:0},
    aquifer:{vol:400,cap:400,recharge:3.2},
    houses:HOUSE_POS.map((p,i)=>({x:p.x,y:p.y,id:i+1,type:i===2?'clinic':i===7?'school':i===4?'kiosk':'house',
      used:0,bill:0,read:false,paid:0,conn:true,dry:0,sat:1,seed:Math.random()})),
    leaks:[], chlorine:.42, crew:{busy:0,max:1},
    reading:false, readProg:0, readDone:false, billed:false,
    produced:0, billedVol:0, lostVol:0, collected:0, supplyH:0, supplyTotal:0, days:0,
    absToday:0, warmaWarn:0, warmaFine:0, clLowH:0, choleraRisk:0, outbreak:false,
    hot:false, up:{tank:false,solar:false,vfd:false,crew:false,prepaid:false,zones:false},
    tut:withTut, tutStep:0, tutDone:!withTut, endless:false, nextInspect:INSPECT_DAY,
    events:[], log:[], dead:false, lastEventDay:0, newConnDay:[20,26]
  };
  particles=[]; running=true; paused=false;
  $('#title').classList.add('gone'); setTimeout(()=>$('#title').classList.add('hide'),500);
  $('#game').classList.remove('hide');
  buildShop(); renderAcademy('lessons'); resize();
  if(withTut){ tutStart(); } else { lectSay("Right — you're on your own shift now. Keep the tank above zero, fix leaks fast, and read meters on days <b>25–28</b>. NWASCO inspects on day <b>30</b>. Good luck.",'normal'); }
  toast('info',`Scheme One online · ${DIFF[diff].name} · ${K(G.funds)}`);
  save();
}

/* ── physics ── */
const SIM={
  head(g){ return 30+(g.tank.vol/g.tank.cap)*9; },
  pumpQ(g){ // m³/h
    if(!g.pump.on) return 0;
    let base=14.5*(1-(this.head(g)-30)/220);
    if(!g.power.on) base*= g.up.solar?.42:0;
    if(g.aquifer.vol<40) base*=.45;
    return Math.max(0,base);
  },
  pumpKW(g){
    const q=this.pumpQ(g)/3600, h=this.head(g);
    if(q<=0) return 0;
    const hyd=1000*9.81*q*h;                 // W
    const eff=.52*(g.up.vfd?1.16:1);
    return hyd/eff/1000+.35;
  },
  demand(g){ // m³/h
    const n=g.houses.filter(h=>h.conn).length;
    const f=DIURNAL[Math.floor(g.hour)%24];
    return n*.35*f*DIFF[g.diff].demand*(g.hot?1.28:1);
  },
  leakQ(g){ let s=0; for(const l of g.leaks) s+=(.9+l.sev*2.6); return s*(g.up.zones?.6:1); },
  residualDecay(g){ return .011*(1+(g.tank.vol/Math.max(g.tank.cap,1))*.6); }
};

/* ── time / main sim ── */
function advance(h){
  const g=G, D=DIFF[g.diff];
  /* power schedule */
  if(!g.tut){
    const blk=SHED_BLOCKS[(g.day-START_DAY)%SHED_BLOCKS.length];
    const shedHours=D.shed>=1.35?4.5:D.shed>=1?4:3;
    const on=!(g.hour>=blk[0]&&g.hour<blk[0]+shedHours);
    if(on!==g.power.on){
      g.power.on=on;
      if(!on){ audio.clunk(); shake(.5); toast('warn','ZESCO load-shedding — grid OFF. Your tank is the buffer.'); spark(); }
      else { toast('ok','Grid restored. Pump window open.'); audio.chime(1); }
    }
  }
  /* pump */
  const q=SIM.pumpQ(g), kw=SIM.pumpKW(g);
  if(q>0){
    const vol=q*h;
    const room=g.tank.cap-g.tank.vol;
    const into=Math.min(vol,room);
    const over=vol-into;
    g.tank.vol+=into; g.aquifer.vol=Math.max(0,g.aquifer.vol-vol);
    g.produced+=into; g.absToday+=vol; g.lostVol+=over;
    g.funds-=kw*h*POWER_KWH;
    if(over>.05&&Math.random()<h*.4) toast('warn','Tank overflowing — water wasted. Stop the pump when full.');
  }
  g.aquifer.vol=Math.min(g.aquifer.cap,g.aquifer.vol+g.aquifer.recharge*h);
  /* demand + leaks */
  const dem=SIM.demand(g)*h, lk=SIM.leakQ(g)*h;
  const served=Math.min(dem,g.tank.vol);
  g.tank.vol=Math.max(0,g.tank.vol-served-lk);
  g.lostVol+=lk+Math.max(0,dem-served)*0;
  const dry=dem-served>.001;
  const per=served/Math.max(1,g.houses.filter(x=>x.conn).length);
  for(const hs of g.houses){ if(!hs.conn)continue;
    hs.used+=per; if(dry){hs.dry+=h;hs.sat=clamp(hs.sat-h*.035,0,1);} else {hs.dry=Math.max(0,hs.dry-h*2);hs.sat=clamp(hs.sat+h*.02,0,1);} }
  if(!dry) g.supplyH+=h;
  g.supplyTotal+=h;
  /* kiosk / prepaid daily cash */
  const share=g.up.prepaid?.95:.4;
  g.funds+=served*TARIFF*share*(g.up.prepaid?.98:D.collect);
  g.collected+=served*TARIFF*share*(g.up.prepaid?.98:D.collect);
  g.billedVol+=served*share;
  for(const hs of g.houses) if(hs.conn) hs.used=Math.max(0,hs.used-per*share);
  /* chlorine */
  g.chlorine=Math.max(0,g.chlorine-SIM.residualDecay(g)*h);
  if(g.chlorine<.18) g.clLowH+=h; else g.clLowH=Math.max(0,g.clLowH-h*.5);
  /* cholera risk */
  if(g.supplyH<10&&g.chlorine<.2) g.choleraRisk=clamp(g.choleraRisk+h*2.4,0,100);
  else g.choleraRisk=clamp(g.choleraRisk-h*.9,0,100);
  if(g.choleraRisk>72&&!g.outbreak){
    g.outbreak=true; g.funds-=2500; g.xp=Math.max(0,g.xp-60);
    toast('bad','CHOLERA ALERT — households turned to shallow wells. MoH emergency response: K2,500.');
    lectSay("This is the lesson that matters most. When supply hours collapse and chlorine is low, people fetch from shallow wells — and cholera follows. <b>Supply hours are a public-health indicator, not a convenience.</b>",'alert');
    audio.alarm(); shake(1);
  }
  if(g.outbreak&&g.choleraRisk<25){ g.outbreak=false; toast('ok','Outbreak contained. Residual chlorine restored.'); }
  /* WARMA */
  if(g.absToday>WARMA_CAP&&g.warmaWarn<2){
    g.warmaWarn++; g.funds-=600; g.warmaFine+=600;
    toast('reg',`WARMA: abstraction ${Math.round(g.absToday)} m³ exceeds your ${WARMA_CAP} m³/day licence. Fine K600.`);
    audio.alarm();
  }
  /* leaks grow */
  for(const l of g.leaks) l.sev=Math.min(1,l.sev+h*.012);
  /* crew */
  if(g.crew.busy>0){ g.crew.busy=Math.max(0,g.crew.busy-h); if(g.crew.busy===0&&g.pendingFix){ finishFix(); } }
  /* reading sweep */
  if(g.reading){
    g.readProg+=h/6;
    if(g.readProg>=1){ g.reading=false; g.readDone=true;
      for(const hs of g.houses) if(hs.conn){ hs.read=true; hs.bill=hs.used; }
      toast('ok','Meter round complete. Bills ready to issue.'); audio.chime(2);
      if(g.tut) tutNotify('read');
    }
  }
  /* random events */
  if(!g.tut&&Math.random()<h*.055*D.leakRate&&g.leaks.length<3) spawnLeak();
  /* hour rollover */
  g.hour+=h;
  while(g.hour>=24){ g.hour-=24; endDay(); }
}
function endDay(){
  const g=G;
  g.day++; g.days++; g.xp+=50; g.funds-=OPEX_DAY;
  g.supplyTotal=Math.max(g.supplyTotal,1);
  g.lastSupplyH=g.supplyH; g.supplyH=0; g.absToday=0; g.hot=Math.random()<.3;
  if(g.hot) toast('warn','Hot day — demand up 28%. Watch your storage.');
  if(g.newConnDay.includes(g.day)){
    const off=g.houses.filter(h=>!h.conn);
    if(off.length){ off[0].conn=true; g.funds+=150; toast('ok',`New connection #${off[0].id} — K150 fee paid. Revenue up.`); audio.coin(); }
  }
  if(g.day>READ_B&&!g.readDone&&!g.up.prepaid&&!g.billed){
    toast('bad','Reading window missed — bills will be estimated. Collection and NWASCO metering score suffer.');
    for(const hs of g.houses) if(hs.conn){ hs.bill=hs.used*.8; hs.read=false; }
    g.readDone=true;
  }
  if(g.day===READ_A&&!g.up.prepaid){ toast('info','📖 Meter reading window OPEN (days 25–28). Tap READ.'); lectSay("Reading window is open. <b>Consumption = current reading − previous reading.</b> Read accurately: NWASCO scores your metering ratio, and estimated bills destroy customer trust.",'normal'); }
  if(g.day===g.nextInspect-2) lectSay("NWASCO inspection in two days. They score <b>supply hours, non-revenue water, collection efficiency, water quality and WARMA compliance</b>. Fix what you can.",'alert');
  checkLevel();
  if(g.funds<-2000&&!g.dead){ g.dead=true; showFail(); }
  if(g.day>g.nextInspect){ showReport(); }
  save();
}
function checkLevel(){
  const lv=Math.floor(G.xp/300)+1;
  if(lv>G.level){ G.level=lv; toast('ok',`Level ${lv} — new capital options unlocked.`); audio.chime(3); confetti(); buildShop(); }
}

/* ── actions ── */
function togglePump(){
  const g=G;
  if(!g.power.on&&!g.up.solar){ toast('bad','No power. ZESCO is shedding — buy Solar + Battery to pump through outages.'); audio.err(); return; }
  if(g.tank.vol>=g.tank.cap-.5&&!g.pump.on){ toast('warn','Tank already full.'); return; }
  g.pump.on=!g.pump.on;
  audio.click(); if(g.pump.on) audio.pumpStart(); else audio.pumpStop();
  if(g.tut) tutNotify('pump');
  syncUI();
}
function spawnLeak(){
  const g=G, row=Math.random()<.5?320:510;
  const l={x:rnd(120,880),y:row+rnd(-6,6),sev:rnd(.15,.4),id:Math.random()};
  g.leaks.push(l);
  toast('bad','PIPE BURST on the main — water is escaping. Tap FIX LEAK.');
  audio.alarm(); shake(.8);
  if(!g.leakTaught){ g.leakTaught=true;
    lectSay("A burst. Notice the tank dropping faster — that is <b>non-revenue water</b>: you paid to pump it and nobody paid you for it. Leak flow rises with pressure, so fix fast.",'alert'); }
  syncUI();
}
function fixLeak(idx){
  const g=G;
  if(!g.leaks.length){ toast('info','No leaks on the network right now.'); return; }
  if(g.crew.busy>0){ toast('warn','Crew already on a job. Buy a second crew to work faster.'); audio.err(); return; }
  if(g.funds<REPAIR_COST){ toast('bad',`Repair needs ${K(REPAIR_COST)}. Not enough funds.`); audio.err(); return; }
  g.funds-=REPAIR_COST;
  g.pendingFix=idx!=null?idx:0;
  g.crew.busy=g.up.crew?1.1:2.2;
  audio.click(); toast('info','Crew dispatched — repair in progress…');
  syncUI();
}
function finishFix(){
  const g=G, i=g.pendingFix; g.pendingFix=null;
  if(g.leaks[i]){ const l=g.leaks[i]; splash(l.x,l.y); g.leaks.splice(i,1); }
  g.xp+=15; checkLevel(); audio.chime(1);
  toast('ok','Repair complete. Losses reduced.');
  if(g.tut) tutNotify('fix');
  syncUI();
}
function dose(){
  const g=G;
  if(g.funds<DOSE_COST){ toast('bad','Not enough funds for chlorine.'); audio.err(); return; }
  if(g.chlorine>.62){ toast('warn','Residual already high — over-dosing wastes chemical and tastes bad.'); return; }
  g.funds-=DOSE_COST; g.chlorine=Math.min(.85,g.chlorine+.26); g.xp+=5;
  puff(430,150); audio.click(); toast('ok',`Chlorine dosed · residual ${g.chlorine.toFixed(2)} mg/L`);
  checkLevel(); if(g.tut) tutNotify('cl'); syncUI();
}
function startRead(){
  const g=G;
  if(g.up.prepaid){ toast('info','Prepaid meters report automatically — no manual round needed.'); return; }
  if(g.day<READ_A||g.day>READ_B){ toast('warn',`Reading window is days ${READ_A}–${READ_B}. Today is day ${g.day}.`); audio.err(); return; }
  if(g.readDone){ toast('info','Already read this month. Issue the bills.'); return; }
  if(g.reading) return;
  if(g.funds<READ_COST){ toast('bad','Cannot pay the meter reader.'); audio.err(); return; }
  g.funds-=READ_COST; g.reading=true; g.readProg=0; audio.click();
  toast('info','Meter reader walking the network…'); syncUI();
}
function issueBills(){
  const g=G;
  if(g.up.prepaid){ toast('info','Prepaid customers pay as they use — nothing to bill.'); return; }
  if(!g.readDone){ toast('warn','Read the meters first.'); audio.err(); return; }
  if(g.billed){ toast('info','Bills already issued this cycle.'); return; }
  const D=DIFF[g.diff];
  let gross=0, vol=0;
  const satAvg=g.houses.filter(h=>h.conn).reduce((s,h)=>s+h.sat,0)/Math.max(1,g.houses.filter(h=>h.conn).length);
  const eff=clamp(D.collect*(g.houses.every(h=>h.read||!h.conn)?1:.72)*(.7+satAvg*.4),.3,.99);
  for(const hs of g.houses){ if(!hs.conn)continue; gross+=hs.bill*TARIFF; vol+=hs.bill; hs.paid=hs.bill*TARIFF*eff; hs.bill=0; hs.used=0; hs.read=false; }
  const net=gross*eff;
  g.funds+=net; g.collected+=net; g.billedVol+=vol*eff; g.billed=true; g.readDone=false; g.xp+=30;
  g.lastCollection=eff;
  coinBurst(net);
  audio.coin(); toast('ok',`Bills issued · collected ${K(net)} of ${K(gross)} (${Math.round(eff*100)}% collection efficiency)`);
  lectSay(`That gap — ${K(gross-net)} uncollected — is why <b>collection efficiency</b> is a NWASCO indicator. Customers who trust their bill pay it. Estimated bills and dry taps destroy that trust.`,'happy');
  checkLevel(); syncUI();
}

