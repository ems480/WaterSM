/* ── wiring ── */
let diffSel=0;
$$('.diff').forEach(b=>b.onclick=()=>{ $$('.diff').forEach(x=>x.classList.remove('on')); b.classList.add('on'); diffSel=+b.dataset.d; audio.click(); });
$('#btnStart').onclick=()=>{ audio.ensure(); newGame(diffSel,true); };
$('#btnSkipTut').onclick=()=>{ audio.ensure(); newGame(diffSel,false); };
$('#btnContinue').onclick=()=>{ const s=load(); if(!s)return; audio.ensure(); G=s; running=true; paused=false;
  $('#title').classList.add('gone'); setTimeout(()=>$('#title').classList.add('hide'),500); $('#game').classList.remove('hide');
  buildShop(); resize(); G.tut=false; $('#lectNext').style.display='none'; $('#lectSkip').style.display='none';
  lectSay("Welcome back. Your scheme was saved. Pick up where you left off.",'happy'); syncUI(); toast('ok','Scheme restored.'); };
$('#btnAcademyTitle').onclick=()=>{ renderAcademy('lessons'); open_('academy'); };
$('#aPump').onclick=togglePump;
$('#aFix').onclick=()=>fixLeak(null);
$('#aCl').onclick=dose;
$('#aRead').onclick=startRead;
$('#aBill').onclick=issueBills;
$('#aShop').onclick=()=>open_('shop');
$('#btnPause').onclick=()=>{ paused=!paused; $('#pauseVeil').style.display=paused?'grid':'none'; $('#btnPause').textContent=paused?'▶':'⏸'; audio.click(); };
$('#btnSpeed').onclick=()=>{ speed=speed===1?2:speed===2?4:1; $('#btnSpeed').textContent=speed+'×'; audio.click(); };
$('#btnSound').onclick=()=>{ audio.setOn(!soundOn); $('#btnSound').textContent=soundOn?'🔊':'🔇'; $('#btnSound').setAttribute('aria-pressed',String(soundOn)); };
$('#btnMenu').onclick=()=>open_('menu');
$('#mAcademy').onclick=()=>{ closeAll(); renderAcademy('lessons'); open_('academy'); };
$('#mSave').onclick=()=>{ save(); toast('ok','Scheme saved.'); closeAll(); };
$('#mRestart').onclick=()=>{ closeAll(); newGame(G.diff,false); };
$('#mTitle').onclick=()=>{ save(); toTitle(); };
window.addEventListener('pointerdown',function once(){ audio.ensure(); window.removeEventListener('pointerdown',once); },{once:true});
window.addEventListener('keydown',e=>{
  if(e.code==='Space'){ e.preventDefault(); $('#btnPause').click(); }
  if(e.code==='KeyP') togglePump(); if(e.code==='KeyF') fixLeak(null);
  if(e.code==='KeyC') dose(); if(e.code==='KeyR') startRead(); if(e.code==='KeyB') issueBills();
  if(e.code==='Escape') closeAll();
});
document.addEventListener('visibilitychange',()=>{ if(document.hidden){ save(); audio.ctx&&audio.ctx.suspend(); } else { lastNow=performance.now(); audio.ctx&&soundOn&&audio.ctx.resume(); } });
window.__onAndroidBack=()=>{ if($('.drawer.open')){ closeAll(); return true; } if($('#report').classList.contains('open')) return true; return false; };

/* ── loop ── */
let uiAcc=0,auAcc=0;
function loop(now){
  requestAnimationFrame(loop);
  const dt=Math.min(.05,(now-lastNow)/1000||0); lastNow=now; tReal+=dt;
  if(!running||!G){ return; }
  if(!paused){
    const h=dt*(G.tut?.35:.5*speed);
    advance(h);
    if(G.tut) tutCheck();
  }
  updateParticles(dt);
  drawMap(G,tReal);
  uiAcc+=dt; if(uiAcc>.15){ uiAcc=0; syncUI(); }
  auAcc+=dt; if(auAcc>.12){ auAcc=0; audio.update(G); }
}
if(load()) $('#btnContinue').classList.remove('hide');
renderAcademy('lessons'); resize(); requestAnimationFrame(loop);
</script>
</body>
</html>
